# Copy this file to .env and paste at least one key. Never commit .env.
# One key is enough. With both, the app falls back to the other if one fails.

GEMINI_API_KEY=
OPENAI_API_KEY=

# ElevenLabs: natural voice for every language + Scribe speech-to-text
ELEVENLABS_API_KEY=

# Optional
# AI_PROVIDER=gemini            # which one to try first for answers: gemini or openai
# GEMINI_MODEL=gemini-flash-latest
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb   # any voice ID from your ElevenLabs voice library
# ELEVENLABS_STT_MODEL=scribe_v2
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5     # or per language: ELEVENLABS_TTS_MODEL_ML=eleven_v3
