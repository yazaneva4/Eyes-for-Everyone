# Copy this file to .env and paste your keys. Never commit .env.

# Answers about the photo: at least one of these. With both, one backs up the other.
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ElevenLabs: natural voice in every language + Scribe speech-to-text
ELEVENLABS_API_KEY=

# Optional
# AI_PROVIDER=gemini                           # which answers first: gemini or openrouter
# GEMINI_MODEL=                                # empty = cheapest available Flash-Lite, tried in price order
# GEMINI_FALLBACK_MODEL=                       # empty = no second Gemini; free OpenRouter is the backup
# OPENROUTER_MODEL=qwen/qwen3.8-27b:free        # only free models are allowed (id must end in :free)
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb      # any voice ID from your ElevenLabs voice library
# ELEVENLABS_STT_MODEL=scribe_v2
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5        # or per language: ELEVENLABS_TTS_MODEL_ML=eleven_v3
