# Copy this file to .env and paste at least one key. Never commit .env.
# One key is enough. With both, the app falls back to the other if one fails.

GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional
# AI_PROVIDER=gemini            # which one to try first for answers: gemini or openai
# GEMINI_MODEL=gemini-flash-latest
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
